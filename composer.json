{
    "name": "bradtipper/silverstripe-revenuecat",
    "description": "RevenueCat webhook, subscription event log and subscription emails for silverstripe-restful-framework apps",
    "type": "silverstripe-vendormodule",
    "license": "proprietary",
    "keywords": ["silverstripe", "revenuecat", "subscriptions"],
    "require": {
        "php": "^8.3",
        "bradtipper/silverstripe-restful-framework": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "BradTipper\\AppBackend\\Account\\": "src/Account/",
            "BradTipper\\AppBackend\\Admin\\": "src/Admin/",
            "BradTipper\\AppBackend\\Model\\": "src/Model/",
            "BradTipper\\AppBackend\\Support\\": "src/Support/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
