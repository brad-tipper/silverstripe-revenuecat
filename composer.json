{
    "name": "bradtipper/silverstripe-revenuecat",
    "description": "RevenueCat webhook, subscription event log and subscription emails for silverstripe-restful-framework apps",
    "type": "silverstripe-vendormodule",
    "license": "proprietary",
    "keywords": ["silverstripe", "revenuecat", "subscriptions"],
    "require": {
        "php": "^8.3",
        "bradtipper/silverstripe-restful-framework": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "BradTipper\\RestfulFramework\\Account\\": "src/Account/",
            "BradTipper\\RestfulFramework\\Admin\\": "src/Admin/",
            "BradTipper\\RestfulFramework\\Model\\": "src/Model/",
            "BradTipper\\RestfulFramework\\Support\\": "src/Support/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
